<service>
    <id>ProdDashMCMS</id>
    <name>ANDRITZ ProdDash MCMS</name>
    <description>ANDRITZ Production Dashboard service for MCMS.</description>

    <executable>%BASE%\ProdDashMCMS.exe</executable>

    <workingdirectory>%BASE%</workingdirectory>

    <startmode>Automatic</startmode>

    <onfailure action="restart" delay="10 sec" />

    <log mode="roll" />

    <stoptimeout>15 sec</stoptimeout>
</service>